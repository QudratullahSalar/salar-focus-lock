<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimum-capability configuration for FocusLockAccessibilityService.

  - accessibilityEventTypes="typeWindowStateChanged": the only event type needed to learn
    which app just came to the foreground. No typeViewTextChanged, typeViewClicked,
    typeNotificationStateChanged, etc. are requested.
  - canRetrieveWindowContent="false": this service never reads on-screen text/content, so
    window-content retrieval is explicitly disabled rather than merely unused.
  - No android:packageNames attribute: intentionally left unset so events arrive for ANY
    foreground app. This is required because the blocked-app set changes per active
    FocusRule at runtime; a static allow-list here can't reflect that.
  - No android:flagRequestFilterKeyEvents / flagRequestTouchExplorationMode / etc. — none of
    the optional capability flags are requested.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/accessibility_service_description" />
